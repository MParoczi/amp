#!/usr/bin/env bash
# amp's tests for scripts/render: fixtures in a temp root (its path has a space),
# then the real repo; then codex/install in temp CODEX_HOMEs and the manifests, then the per-tool text in the rendered trees,
# then the Codex hooks against a temp git repo. One "ok: <case>" line per case; the first failure prints
# "FAIL: <case>: <detail>" and exits 1. Runs from anywhere.
#
# Usage: scripts/test
set -euo pipefail

[ $# -eq 0 ] || { echo "usage: scripts/test" >&2; exit 2; }
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/amp test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
case=

fail() { echo "FAIL: $case: $*"; exit 1; }
ok() { echo "ok: $case"; }
# fx NAME: start a fresh fixture root at $fx
fx() { fx="$tmp/$1"; mkdir -p "$fx/src/skills" "$fx/src/agents"; }
# put PATH CONTENT: write a file under the fixture root
put() { mkdir -p "$(dirname "$fx/$1")"; printf '%s' "$2" > "$fx/$1"; }
# render [ARGS]: run the renderer on the fixture; sets $rc, $out (stdout) and $err (stderr)
render() {
  rc=0
  AMP_RENDER_ROOT="$fx" bash "$ROOT/scripts/render" "$@" > "$tmp/out" 2> "$tmp/err" || rc=$?
  out=$(cat "$tmp/out"); err=$(cat "$tmp/err")
}
rendered() { render; [ "$rc" -eq 0 ] || fail "render exited $rc: $err"; }
# same PATH TEXT: the fixture file's content is exactly TEXT (trailing newlines aside)
same() {
  [ -f "$fx/$1" ] || fail "$1 missing"
  want=$(printf '%s' "$2")
  [ "$(cat "$fx/$1")" = "$want" ] || fail "$1 is '$(cat "$fx/$1")', want '$want'"
}
absent() { [ ! -e "$fx/$1" ] || fail "$1 should not exist"; }

case=blocks
fx "$case"
put src/skills/x/SKILL.md $'<!-- claude -->\nC\n<!-- /claude -->\n<!-- codex -->\nX\n<!-- /codex -->\n'
rendered
same skills/x/SKILL.md C
same codex/skills/x/SKILL.md X
ok

case=spans
fx "$case"
put src/skills/x/SKILL.md $'a {{claude: one}}{{codex: two}} b\n'
rendered
same skills/x/SKILL.md 'a one b'
same codex/skills/x/SKILL.md 'a two b'
ok

case=variants
fx "$case"
put src/skills/x/templates/T.claude.md $'t\n'
put src/skills/x/templates/C.codex.toml $'c = 1\n'
rendered
same skills/x/templates/T.md t
same codex/skills/x/templates/C.toml 'c = 1'
absent codex/skills/x/templates/T.md
absent skills/x/templates/C.toml
[ -z "$(find "$fx/skills" "$fx/codex" -name '*.claude.*' -o -name '*.codex.*')" ] || fail "a variant kept its tool suffix"
ok

case=rewrites
fx "$case"
line='amp:reviewer amp:implementer amp:checker amp:scout ${CLAUDE_PLUGIN_ROOT}/skills/build/x ${CLAUDE_SKILL_DIR}/scripts/y amp:phase /amp:phase 04'
put src/skills/x/SKILL.md "$line"$'\n'
rendered
same skills/x/SKILL.md "$line"
same codex/skills/x/SKILL.md 'amp-reviewer amp-implementer amp-checker amp-scout <skills>/build/x scripts/y amp:phase $amp:phase 04'
ok

case=frontmatter
fx "$case"
src=$'---\nname: x\ndescription: d\nargument-hint: "[a]"\neffort: high\n---\nbody\n'
put src/skills/x/SKILL.md "$src"
rendered
same skills/x/SKILL.md "$src"
same codex/skills/x/SKILL.md $'---\nname: x\ndescription: d\n---\nbody'
ok

case=frontmatter-markup
fx "$case"
put src/skills/x/SKILL.md $'---\nname: x\ndescription: d {{claude: A}}{{codex: B}}\n---\nbody\n'
put src/agents/a.md $'---\nname: a\ndescription: d {{claude: A}}{{codex: B}}\n---\nbody\n'
rendered
same skills/x/SKILL.md $'---\nname: x\ndescription: d A\n---\nbody'
same codex/skills/x/SKILL.md $'---\nname: x\ndescription: d B\n---\nbody'
same agents/a.md $'---\nname: a\ndescription: d A\n---\nbody'
grep -qxF 'description = "d B"' "$fx/codex/agents/amp-a.toml" || fail "amp-a.toml lacks 'description = \"d B\"'"
ok

case=scripts
fx "$case"
put src/skills/x/scripts/s $'#!/usr/bin/env bash\necho hi\n'
chmod +x "$fx/src/skills/x/scripts/s"
rendered
for t in skills codex/skills; do
  cmp -s "$fx/src/skills/x/scripts/s" "$fx/$t/x/scripts/s" || fail "$t/x/scripts/s differs"
  [ -x "$fx/$t/x/scripts/s" ] || fail "$t/x/scripts/s is not executable"
done
ok

case=toml
fx "$case"
src=$'---\nname: a\ndescription: say "hi" \\ ok\nmodel: opus\neffort: high\n---\nbody é \\d\n'
put src/agents/a.md "$src"
rendered
same agents/a.md "$src"
same codex/agents/amp-a.toml "# Generated by scripts/render from src/agents/a.md. Do not edit.
name = \"amp-a\"
description = \"say \\\"hi\\\" \\\\ ok\"
developer_instructions = '''
body é \\d
'''"
ok

case=errors
# bad NAME PATH CONTENT LINE: rendering CONTENT at PATH fails at LINE and keeps old outputs
bad() {
  fx "$case-$1"
  put skills/x/SKILL.md old
  put "$2" "$3"
  render
  [ "$rc" -eq 1 ] || fail "$1: exit $rc, want 1"
  case $err in *"render: $2:$4:"*) ;; *) fail "$1: stderr is '$err', want 'render: $2:$4:'" ;; esac
  same skills/x/SKILL.md old
}
bad unclosed src/skills/x/SKILL.md $'a\n<!-- claude -->\nb\n' 2
bad stray src/skills/x/SKILL.md $'a\n<!-- /codex -->\n' 2
bad nested src/skills/x/SKILL.md $'<!-- claude -->\n<!-- codex -->\n<!-- /codex -->\n<!-- /claude -->\n' 2
bad span src/skills/x/SKILL.md $'a\nb {{codex: c\n' 2
bad agent src/agents/a.md $'---\nname: a\ndescription: d\n---\nx \'\'\'\n' 5
ok

case=variant-markup
fx "$case"
put src/skills/x/templates/T.claude.md $'a {{claude: b}}{{codex: c}}\n'
rendered
same skills/x/templates/T.md 'a b'
ok

case=check
fx "$case"
put src/skills/x/SKILL.md $'s\n'
put src/agents/a.md $'---\nname: a\ndescription: d\n---\nb\n'
rendered
render --check
[ "$rc" -eq 0 ] && [ "$out" = "render: up to date" ] || fail "fresh: exit $rc, '$out'"
# stale WHAT PATH: --check after WHAT reports PATH, then a render repairs it
stale() {
  render --check
  [ "$rc" -eq 1 ] || fail "$1: exit $rc, want 1"
  case $out in *"render: stale: $2"*) ;; *) fail "$1: output is '$out', want 'render: stale: $2'" ;; esac
  rendered
}
printf 'edit\n' >> "$fx/skills/x/SKILL.md"; stale edited skills/x/SKILL.md
rm "$fx/codex/skills/x/SKILL.md"; stale deleted codex/skills/x/SKILL.md
put agents/extra.md $'e\n'; stale extra agents/extra.md
ok

case=no-src
fx "$case"
rm -r "$fx/src/skills"
put skills/x/SKILL.md old
render
[ "$rc" -eq 1 ] || fail "exit $rc, want 1"
same skills/x/SKILL.md old
ok

case=agents-real
n=0
for f in "$ROOT"/codex/agents/amp-*.toml; do
  [ -f "$f" ] || break
  n=$((n + 1)); a=$(basename "$f" .toml)
  grep -qxF "name = \"$a\"" "$f" || fail "$a: no name line"
  ! grep -qE '^model(_reasoning_effort)? *=' "$f" || fail "$a: has a model line"
  grep -qxF "developer_instructions = '''" "$f" || fail "$a: no developer_instructions block"
  [ "$(grep -cF "'''" "$f")" -eq 2 ] && [ "$(tail -n 1 "$f")" = "'''" ] || fail "$a: block not closed"
done
[ "$n" -eq 4 ] || fail "$n agent TOMLs, want 4"
ok

case=modes
lines=$(git -C "$ROOT" ls-files -s -- scripts/render scripts/test codex/install codex/hooks/amp-hook \
  'skills/build/scripts/*' 'codex/skills/build/scripts/*' 'src/skills/build/scripts/*')
[ -n "$lines" ] || fail "no tracked scripts"
printf '%s\n' "$lines" | grep -q '[[:space:]]codex/hooks/amp-hook$' || fail "codex/hooks/amp-hook not tracked"
bad=$(printf '%s\n' "$lines" | grep -v '^100755 ' || true)
[ -z "$bad" ] || fail "not 100755: $bad"
ok

case=drift
bash "$ROOT/scripts/render" --check > "$tmp/out" 2>&1 || fail "$(cat "$tmp/out")"
ok

# inst [ARGS]: run codex/install in a fresh temp CODEX_HOME ($home, agents in $dir);
# sets $rc and $out (stdout and stderr). CWD=DIR runs it from DIR.
inst() {
  home=$(mktemp -d "$tmp/home.XXXXXX"); dir=$home/agents
  rc=0
  (cd "${CWD:-$ROOT}" && CODEX_HOME="$home" bash "$ROOT/codex/install" "$@") > "$tmp/out" 2>&1 || rc=$?
  out=$(cat "$tmp/out")
}
# has TEXT: the installer output contains TEXT
has() { case $out in *"$1"*) ;; *) fail "output lacks '$1': $out" ;; esac; }
# count PREFIX N: the installer output has N lines starting with PREFIX
count() { [ "$(printf '%s\n' "$out" | grep -c "^$1" || true)" -eq "$2" ] || fail "want $2 '$1' lines: $out"; }
roles="reviewer implementer checker scout"

case=install-default
inst
[ "$rc" -eq 0 ] || fail "exit $rc: $out"
for r in $roles; do [ -f "$dir/amp-$r.toml" ] || fail "amp-$r.toml missing"; done
[ "$(ls "$dir" | wc -l)" -eq 5 ] || fail "files: $(ls "$dir")"
grep -qF '"version": "1.5.0"' "$dir/amp-install.json" || fail "json: $(cat "$dir/amp-install.json")"
[ "$(grep -oF ': null' "$dir/amp-install.json" | wc -l)" -eq 4 ] || fail "json: $(cat "$dir/amp-install.json")"
count 'installed: ' 4
has "wrote: $dir/amp-install.json"
ok

case=install-pin
inst --reviewer gpt-x
[ "$rc" -eq 0 ] || fail "exit $rc: $out"
grep -qF '"reviewer": "gpt-x"' "$dir/amp-install.json" || fail "json: $(cat "$dir/amp-install.json")"
[ "$(grep -oF ': null' "$dir/amp-install.json" | wc -l)" -eq 3 ] || fail "json: $(cat "$dir/amp-install.json")"
has "amp-reviewer.toml (model: gpt-x)"
for r in $roles; do cmp -s "$ROOT/codex/agents/amp-$r.toml" "$dir/amp-$r.toml" || fail "amp-$r.toml differs"; done
ok

case=install-uninstall-flags
inst --uninstall --scout gpt-x
[ "$rc" -eq 2 ] || fail "exit $rc, want 2"
has usage:
ok

case=install-invalid
inst --scout 'a b'
[ "$rc" -eq 2 ] || fail "exit $rc, want 2"
has "install: invalid model 'a b'"
[ -z "$(ls -A "$home")" ] || fail "wrote: $(ls -A "$home")"
for a in --bogus --scout '--scout --reviewer'; do
  # shellcheck disable=SC2086 # $a splits into flags on purpose
  inst $a
  [ "$rc" -eq 2 ] || fail "$a: exit $rc, want 2"
  has usage:
done
ok

case=install-project
repo=$tmp/repo; mkdir -p "$repo" "$tmp/norepo"
git -C "$repo" init -q
CWD=$repo inst --project
[ "$rc" -eq 0 ] || fail "exit $rc: $out"
for r in $roles; do [ -f "$repo/.codex/agents/amp-$r.toml" ] || fail ".codex/agents/amp-$r.toml missing"; done
[ -f "$repo/.codex/agents/amp-install.json" ] || fail "amp-install.json missing"
[ ! -e "$dir" ] || fail "wrote CODEX_HOME too"
GIT_CEILING_DIRECTORIES=$tmp CWD=$tmp/norepo inst --project
[ "$rc" -eq 1 ] || fail "outside a repo: exit $rc, want 1"
ok

case=uninstall
inst
printf 'x\n' > "$dir/other.toml"
CODEX_HOME=$home bash "$ROOT/codex/install" --uninstall > "$tmp/out" 2>&1 || fail "exit $?"
out=$(cat "$tmp/out")
count 'removed: ' 5
[ "$(ls "$dir")" = other.toml ] || fail "left: $(ls "$dir")"
CODEX_HOME=$home bash "$ROOT/codex/install" --uninstall > "$tmp/out" 2>&1 || fail "second run: exit $?"
out=$(cat "$tmp/out")
has "not installed: $dir"
ok

case=manifests
cx=$ROOT/.codex-plugin/plugin.json
grep -qF '"skills": "./codex/skills"' "$cx" || fail "no skills path"
grep -qF '"hooks": "./codex/hooks/hooks.json"' "$cx" || fail "no hooks path"
for m in "$ROOT/.claude-plugin/plugin.json" "$cx"; do
  grep -qF '"version": "1.5.0"' "$m" || fail "$m: version is not 1.5.0"
done
d=$(grep -F '"description":' "$ROOT/.claude-plugin/plugin.json" | head -n 1)
[ "$d" = "$(grep -F '"description":' "$cx" | head -n 1)" ] || fail "plugin.json descriptions differ"
[[ $d == *Codex* ]] || fail "plugin description does not mention Codex"
ok

# holds FILE TEXT...: the repo file FILE contains every TEXT
holds() { f=$1; shift; for s in "$@"; do grep -qF -- "$s" "$ROOT/$f" || fail "$f lacks '$s'"; done; }
# lacks FILE TEXT...: the repo file FILE contains no TEXT
lacks() { f=$1; shift; for s in "$@"; do ! grep -qF -- "$s" "$ROOT/$f" || fail "$f has '$s'"; done; }
skills_def="\`<skills>\` is the folder that holds this skill's folder (the parent of this SKILL.md's directory); use its absolute path."

case=leaks
# leak TEXT DIR...: no file under the repo DIRs contains TEXT
leak() {
  txt=$1; shift
  for d in "$@"; do [ -d "$ROOT/$d" ] || fail "$d missing"; done
  hit=$( (cd "$ROOT" && grep -rnF -- "$txt" "$@") | head -n 1 || true)
  [ -z "$hit" ] || fail "'$txt' in $hit"
}
for s in AskUserQuestion 'Skill tool' /amp-models CLAUDE_PLUGIN_ROOT CLAUDE_SKILL_DIR user_config \
  SendMessage PushNotification '{{' '<!-- claude' '<!-- codex' /amp:; do leak "$s" codex; done
for s in spawn_agent request_user_input wait_agent AGENTS.md '{{' '<!-- claude' '<!-- codex'; do leak "$s" skills agents; done
ok

case=codex-phase
holds codex/skills/phase/SKILL.md spawn_agent 'fork_turns: "none"' task_name wait_agent followup_task send_input \
  close_agent 'reasoning_effort: "xhigh"' amp-install.json 'the agents are stale' .codex-plugin/plugin.json \
  '<skills>/../install' AGENTS.md "$skills_def" '<role>_<task id>' checker_3_r2
# Codex agent names allow only [a-z0-9_]
for f in phase build; do lacks "codex/skills/$f/SKILL.md" '-r<R>' '<role>-<'; done
ok

case=codex-preflight
# every Codex skill that spawns amp agents runs the agent preflight first (amp:phase defines it)
for f in "$ROOT"/codex/skills/*/SKILL.md; do
  [ "$f" = "$ROOT/codex/skills/phase/SKILL.md" ] && continue
  ! grep -qE 'spawn_agent|amp-<role>|[Ss]pawn[^.]*`amp-' "$f" || grep -qiE 'agents? preflight|[*]{2}Agents:[*]{2} check' "$f" \
    || fail "${f#"$ROOT/"} spawns agents without the agent preflight"
done
ok

case=skills-defined
for f in "$ROOT"/codex/skills/*/SKILL.md; do
  ! grep -qF '<skills>/' "$f" || holds "${f#"$ROOT/"}" "$skills_def"
done
ok

case=codex-build
holds codex/skills/build/SKILL.md spawn_agent followup_task close_agent
ok

case=codex-agents
holds codex/agents/amp-implementer.toml SKILL.md
ok

case=claude-mechanics
holds skills/phase/SKILL.md /amp-models PushNotification
holds skills/build/prompts/implement.md SendMessage
ok

case=codex-claude-md
# On Codex CLAUDE.md is only the fallback, so every mention also names AGENTS.md
bad=$( (cd "$ROOT" && grep -rnF CLAUDE.md codex) | grep -vF AGENTS.md || true)
[ -z "$bad" ] || fail "CLAUDE.md without AGENTS.md: $bad"
ok

case=codex-grill
holds codex/skills/grill/SKILL.md request_user_input 'numbered text'
lacks codex/skills/grill/SKILL.md 'Plan mode'
ok

case=codex-roadmap
t=codex/skills/roadmap/templates
for f in AGENTS.md config.toml; do [ -f "$ROOT/$t/$f" ] || fail "$t/$f missing"; done
for f in CLAUDE.md settings.json; do [ ! -e "$ROOT/$t/$f" ] || fail "$t/$f should not exist"; done
holds "$t/config.toml" 'model_reasoning_effort = "high"'
holds codex/skills/roadmap/SKILL.md amp-install.json 'the agents are stale' '<skills>/../install <flags>' --project
ok

case=lean-in-agents
# the agents carry the lean rules, so no dispatch loads amp:lean
holds agents/implementer.md '## Lean rules' 'Does this need to exist?' 'accessibility basics' 'data loss' 'lean: <ceiling>' 'shared code' 'calibration knobs' 'string and dynamic references'
holds agents/reviewer.md '## Lean rules' 'accessibility basics' 'calibration knobs' 'string and dynamic references' 'Minor unless they add' 'delete:' 'reuse:' 'stdlib:' 'native:' 'yagni:' 'shrink:' 'net: -'
for f in "$ROOT"/skills/build/prompts/*.md; do
  lacks "${f#"$ROOT/"}" 'amp:lean,' 'amp:lean tag' 'amp:lean review-tag' 'amp:lean ladder'
done
lacks agents/implementer.md "always including \`amp:lean\`"
lacks agents/reviewer.md 'always `amp:lean`'
lacks codex/agents/amp-implementer.toml 'like `amp:lean`'
holds skills/lean/SKILL.md 'shared code'
holds agents/implementer.md 'what the work orphans'
holds skills/debug/SKILL.md 'shared code'
ok

case=effort
# reviewer and implementer at high effort, checker and scout at medium
holds agents/checker.md 'effort: medium'
holds agents/scout.md 'effort: medium' 'at medium effort'
holds codex/skills/phase/SKILL.md 'reasoning_effort: "medium"'
holds codex/skills/build/SKILL.md 'reasoning_effort: "medium"'
lacks skills/phase/SKILL.md 'Every agent runs at **high effort**'
lacks codex/skills/phase/SKILL.md 'Every agent runs at **high effort**'
lacks skills/roadmap/templates/settings.json 'All amp agents run at high effort'
ok

case=reviewer-resume
# fix rounds and confirmations resume the reviewer; amp:checker only when it can't be resumed
holds skills/build/SKILL.md 'reviewer not resumable' "Record the reviewer's agent id"
lacks skills/build/SKILL.md 're-checked by amp:checker'
holds skills/phase/SKILL.md 'reviewer not resumable'
lacks codex/skills/build/SKILL.md 'close each reviewer and checker once its result is read'
holds skills/build/prompts/re-review.md 'resumed' 'amp:checker'
holds codex/skills/build/SKILL.md 'reviewer not resumable' followup_task
holds agents/reviewer.md 'Re-review'
holds skills/design/SKILL.md 'Confirmation re-review'
holds skills/plan/SKILL.md 'Confirmation re-review'
holds skills/roadmap/SKILL.md 'Confirmation re-review'
lacks codex/skills/phase/SKILL.md 'close each reviewer, checker and scout as soon as'
holds codex/skills/phase/SKILL.md 'at once when nothing loops'
holds codex/skills/build/SKILL.md 'at once when nothing loops'
holds hooks/register.tsx 'and fix re-checks'
holds .claude-plugin/plugin.json 'and fix re-checks'
ok

case=routing-once
# amp:phase states model routing and fallback once; the plugin hook injects the Claude model values
lacks skills/phase/SKILL.md '${user_config.' 'Without that section'
lacks skills/build/SKILL.md '## Model fallback'
lacks codex/skills/build/SKILL.md '## Model fallback'
lacks skills/design/SKILL.md 'Model fallback applies'
holds skills/phase/SKILL.md 'amp model routing' 'Fallback (automatic, no question)'
ok

case=depends
# plans fold setup-only tasks; every task names the earlier tasks it depends on (spec 05 §5.1)
holds skills/plan/SKILL.md '**Depends on:** none' 'only setup, config or docs'
holds skills/build/prompts/document-review.md 'Depends on' 'only setup, config or docs'
lacks skills/plan/SKILL.md '**Independent:**'
lacks codex/skills/plan/SKILL.md '**Independent:**'
ok

case=parallel
# amp:build schedules ready tasks, each in its own worktree when others run (spec 05 §5.2–5.8)
holds skills/build/SKILL.md '**Depends on:**' 'Parallel tasks' 'amp-wt-' 'git worktree add' 'merge --ff-only'   'rebase --abort' 'worktree remove --force' 'branch -D' 'worktree prune' 'started (worktree' 'rebased (base'   'dropped — resume' 'Parallel: off' 'git grep' 'Only one task integrates at a time' 'no `Depends on` line'
holds codex/skills/build/SKILL.md 'amp-wt-' 'thread limit'
holds skills/phase/SKILL.md 'amp-wt-' 'Parallel tasks'
holds skills/build/prompts/task-review.md 'Tree:'
holds skills/build/prompts/re-review.md 'Tree:'
for f in skills/build/SKILL.md codex/skills/build/SKILL.md; do lacks "$f" 'Pipelining' '**Independent:**'; done
lacks skills/build/SKILL.md 'never two implementers at once'
for a in implementer reviewer checker; do holds "agents/$a.md" 'git grep' '.amp/'; lacks "agents/$a.md" 'pipelined worktree'; done
holds agents/implementer.md 'git -C'
ok

case=stage-lines
# the ledger lifecycle (spec 04 §5.1): amp:phase (or a standalone amp:build) creates the ledger,
# and each skill appends its Stage line, the later ones only to an existing ledger
for t in skills codex/skills; do
  holds "$t/phase/SKILL.md" '# amp ledger — <NN>-<slug>' 'Stage: grill' 'Branch: <branch>' 'Stage: design' \
    'Stage: stopped — <what is needed>'
  holds "$t/grill/SKILL.md" 'Stage: gate' 'only when $WS/progress.md exists'
  holds "$t/plan/SKILL.md" 'Plan: <plan path>' 'Stage: plan' 'only when $WS/progress.md exists'
  holds "$t/build/SKILL.md" 'Either way, append `Stage: build`' 'If no ledger exists (amp:build run on its own), create it'
  holds "$t/ship/SKILL.md" 'Stage: ship' 'Stage: merged — <PR URL>' 'only when $WS/progress.md exists' \
    'Stage: stopped — <what is needed>'
  lacks "$t/build/SKILL.md" '# amp ledger — plan:'
done
ok

case=alert-wav
# the alert sound (spec 04 §5.3): a small RIFF/WAVE file that git treats as binary
w=$ROOT/hooks/sounds/alert.wav
[ -f "$w" ] || fail "no $w"
[ "$(head -c 4 "$w")" = RIFF ] || fail "does not start with RIFF"
[ "$(dd if="$w" bs=1 skip=8 count=4 2>/dev/null)" = WAVE ] || fail "no WAVE at offset 8"
[ "$(wc -c < "$w")" -lt 16384 ] || fail "$(wc -c < "$w") bytes, want under 16384"
[ "$(git -C "$ROOT" check-attr binary hooks/sounds/alert.wav)" = 'hooks/sounds/alert.wav: binary: set' ] || fail "not binary in git"
ok

# --- the Codex hooks (spec 04 §5.6) ---

case=codex-hooks-file
# the suite has no JSON parser: hooks.json is laid out one key per line, and grepped
h=codex/hooks/hooks.json
[ -f "$ROOT/$h" ] || fail "$h missing"
top=$(sed -nE 's/^  "([^"]*)":.*/\1/p' "$ROOT/$h" | tr '\n' ' ')
[ "$top" = "description hooks " ] || fail "top-level keys: $top"
bad=$(grep -oE '"[A-Za-z_]+":' "$ROOT/$h" | grep -vxE '"(description|hooks|SessionStart|PreToolUse|matcher|type|command|commandWindows|timeout)":' || true)
[ -z "$bad" ] || fail "unknown keys: $bad"
[ "$(grep -cE '^ {12}"' "$ROOT/$h")" -eq 8 ] || fail "want 8 handler key lines"
bad=$(grep -E '^ {12}"' "$ROOT/$h" | grep -vE '^ {12}"(type|command|commandWindows|timeout)": ' || true)
[ -z "$bad" ] || fail "handler keys: $bad"
[ "$(grep -cF '"timeout": 10' "$ROOT/$h")" -eq 2 ] || fail "want two 10 s timeouts"
holds "$h" '"description": "amp: resume guard, autonomy guardrails, read-only roles"' \
  '"matcher": "startup|resume|compact"' '"matcher": "Bash|apply_patch"'
for s in session-start pre-tool-use; do
  holds "$h" "\"command\": \"bash \\\"\$PLUGIN_ROOT/codex/hooks/amp-hook\\\" $s\"" \
    "\"commandWindows\": \"bash \\\"%PLUGIN_ROOT%/codex/hooks/amp-hook\\\" $s\""
done
ok

# A temp git repo for the hook: origin/HEAD → origin/main, a commit to detach at, and a ledger.
hr="$tmp/hook repo"
mkdir -p "$hr/.amp/04-x" "$tmp/no repo"
git -C "$hr" init -q
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
sha=$(git -C "$hr" commit-tree --no-gpg-sign -m init "$(git -C "$hr" mktree < /dev/null)")
git -C "$hr" update-ref refs/remotes/origin/main "$sha"
git -C "$hr" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
hroot=$(git -C "$hr" rev-parse --show-toplevel)
ledger=$hr/.amp/04-x/progress.md
printf '# amp ledger — 04-x\nStage: build\nBranch: feature/04-x\n' > "$ledger"
# on BRANCH: check out BRANCH (unborn is fine), or detach HEAD when BRANCH is empty
on() { if [ -n "$1" ]; then git -C "$hr" symbolic-ref HEAD "refs/heads/$1"; else git -C "$hr" update-ref --no-deref HEAD "$sha"; fi; }
# js TEXT: TEXT as the body of a JSON string. Variables in the replacements, with patsub_replacement
# off where it exists, keep the backslashes literal on every bash from 3.2 on (as in amp-hook).
shopt -u patsub_replacement 2>/dev/null || true
b='\' dq='"' jt='\t' jr='\r' jn='\n'
js() { local s=${1//"$b"/$b$b}; s=${s//"$dq"/$b$dq}; s=${s//$'\t'/$jt}; s=${s//$'\r'/$jr}; printf '%s' "${s//$'\n'/$jn}"; }
jroot=$(js "$hroot")
# bash_json COMMAND [AGENT]: Codex's PreToolUse input for a shell command (from AGENT's loop)
bash_json() { printf '{"session_id":"s","cwd":"%s","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"%s"}%s}' "$jroot" "$(js "$1")" "${2:+,\"agent_type\":\"$2\"}"; }
# patch_json PATCH [AGENT]: the same for apply_patch, whose command is the patch text
patch_json() { printf '{"cwd":"%s","tool_name":"apply_patch","tool_input":{"command":"%s"}%s}' "$jroot" "$(js "$1")" "${2:+,\"agent_type\":\"$2\"}"; }
# hook JSON: pipe JSON to amp-hook pre-tool-use from outside the repo; sets $out, fails on a non-zero exit
hook() { out=$(cd "$tmp" && bash "$ROOT/codex/hooks/amp-hook" pre-tool-use <<< "$1" 2>&1) || fail "exit $? for $1: $out"; }
# denies JSON TEXT: the hook prints a deny whose reason contains TEXT; allows JSON: it prints nothing
denies() { hook "$1"; case $out in *'"permissionDecision":"deny"'*"$2"*) ;; *) fail "want a deny with '$2' for $1, got '$out'" ;; esac; }
allows() { hook "$1"; [ -z "$out" ] || fail "want no output for $1, got '$out'"; }
# guard RULE COMMAND...: each command is denied by RULE (allowed when RULE is empty), on the current branch
guard() { r=$1; shift; for c; do if [ -n "$r" ]; then denies "$(bash_json "$c")" "amp guard: $r is blocked"; else allows "$(bash_json "$c")"; fi; done; }
# ro DENIED COMMAND...: a reviewer is denied (DENIED=1) or allowed (DENIED empty) each command
ro() { d=$1; shift; for c; do if [ -n "$d" ]; then denies "$(bash_json "$c" amp-reviewer)" 'amp read-only: reviewer may not'; else allows "$(bash_json "$c" amp-reviewer)"; fi; done; }
# reason TEXT: the hook's deny line for TEXT
reason() { printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}' "$1"; }
suffix=' (If the user says this run is abandoned, they can delete .amp/04-x/; never delete it yourself.)'
ro_tail='Report the finding instead; write only the report file under .amp/ or outside the repo.'

case=hook-guard
# the §5.4 rows (hooks/guard.test.ts RULES), each in the context it is denied or allowed in
on feature/04-x
guard 'hooks skipped' 'git commit -m "x" -n' 'git commit --no-verify -m x' 'git commit -nm x'
guard '' 'git commit -am "x"' 'git commit -m -n' 'git commit -mnote'
guard 'signing skipped' 'git commit --no-gpg-sign -m x' 'git -c commit.gpgsign=false commit -m x' 'git -c commit.gpgSign=false commit -m x'
guard '' 'git commit -m "x"' 'git -c user.name=x commit -m x'
guard 'force push' 'git push -f' 'git push --force origin x' 'git push --force-with-lease origin x' \
  'git push --force-with-lease=x:abc origin x' 'git push --force-if-includes origin x' 'git push --mirror origin' \
  'git push --delete origin x' 'git push -d origin x' 'git push origin +x' 'git push origin :x'
guard '' 'git push -u origin feature/04-x' 'git push -o ci.skip origin feature/04-x'
guard 'push to default' 'git push origin main' 'git push origin HEAD:main'
guard '' 'git push'
guard 'hard reset' 'git reset --hard' 'git -C ../x reset --hard'
guard '' 'git reset --soft HEAD~1' 'git commit -m x'
guard 'discard work' 'git stash' 'git stash pop' 'git stash -u' 'git checkout -- a.ts' 'git checkout -f x' \
  'git checkout --force x' 'git restore a.ts' 'git restore --staged --worktree a.ts' 'git restore --staged -W a.ts' \
  'git restore -S -W a.ts' 'git clean -fd' 'git clean -xf' 'git clean --force'
guard '' 'git stash list' 'git stash show' 'git restore --staged a.ts' 'git restore -S a.ts' 'git checkout feature/x' 'git clean -n'
guard 'admin merge' 'gh pr merge 5 --admin' 'gh pr merge 5 --merge --admin'
guard '' 'gh pr merge 5 --merge --delete-branch'
on main
guard 'push to default' 'git push' 'git push origin'
guard '' 'git push origin v1.4.0'
guard 'commit on default' 'git commit -m x'
on ''
guard '' 'git push' 'git commit -m x'
guard 'hard reset' 'git reset --hard HEAD~1'
on feature/04-x
hook "$(bash_json 'ls && git reset --hard HEAD')"
[ "$out" = "$(reason "amp guard: hard reset is blocked during an amp run (git reset --hard HEAD). never discard work; revert or fix forward$suffix")" ] \
  || fail "deny text: $out"
denies "$(bash_json 'gh pr merge 5 --admin')" ". stop and ask the user$suffix\"}}"
# the reason is JSON-escaped: a quoted newline, a quote and a backslash in the segment
denies "$(bash_json $'git commit -n -m "a\nb \\" c\\\\"')" '(git commit -n -m a\nb \" c\\)'
ok

case=hook-splitter
# the splitter fixtures and the splitCommands rows, through the hook
on feature/04-x
guard '' 'git commit -m "fix; git push -f"' 'git commit -mnote' $'git commit -F - <<\'EOF\'\ngit push --force is now blocked\nEOF' \
  $'git commit -m "$(cat <<\'EOF\'\ndon\'t git reset --hard\nEOF\n)"' $'cat <<-EOF > f\n\tgit push -f\n\tEOF\ngit status' \
  $'cat <<A <<"B"\ngit push -f\nA\ngit reset --hard\nB\nnext' $'echo \'x\\\ngit push -f\''
guard 'force push' 'git commit -m "x" && git push -f' 'echo "say \"hi\" \\" && git push -f' "x -m \"it's\"; git push -f" \
  'cat <<< "x; y"; git push -f' 'a || git push -f' 'a | git push -f'
guard 'hooks skipped' $'git commit -m x \\\n  -n' $'git commit -m x \\\r\n  -n'
# escaped quotes in the JSON: extracted, never a deny on a mis-parse (Review Focus 5)
allows "{\"cwd\":\"$jroot\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git commit -m \\\"a \\\\\\\"b\\\\\\\"\\\"\"}}"
denies "{\"cwd\":\"$jroot\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git commit -m \\\"a\\\" && git push -f\"}}" 'amp guard: force push'
denies "{\"cwd\":\"$jroot\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git reset --hard origin\\/main\"}}" '(git reset --hard origin/main)'
# malformed JSON: allowed, silently
for j in 'not json' '{"tool_name":"Bash","tool_input":{"command":"git reset --hard"' \
  '{"tool_name":"Bash","tool_input":{"command":"git reset --hard}}'; do allows "$j"; done
ok

case=hook-preauthorized
# amp's own commands pass under the guards (Review Focus 2)
on main
guard '' 'git push origin v1.4.0' 'git tag -a v1.4.0 abc123 -m "phase 04" && git push origin v1.4.0' \
  'git branch -d feature/04-x' 'git switch main && git pull --ff-only' $'git push \\\n  origin v1.4.0'
on feature/04-x
guard '' 'git worktree remove --force .amp/x/wt-2' 'git branch -D amp-wt-2' 'gh pr merge 5 --merge --delete-branch' \
  'git push -u origin feature/04-x'
ok

case=hook-read-only
# the §5.5 rows (hooks/guard.test.ts ROWS) for agent_type amp-reviewer
on feature/04-x
for s in commit push merge rebase reset checkout switch stash add rm mv cherry-pick revert am restore clean pull; do ro 1 "git $s x" "git $s"; done
ro '' 'git status' 'git log --oneline' 'git diff main...HEAD' 'git show HEAD:a.ts'
ro 1 'git tag v1' 'git tag -a v1 -m x' 'git tag -s v1' 'git tag -u key v1' 'git tag -d v1' 'git tag -f v1' 'git tag -mnote v1' \
  'git tag -F f v1' 'git tag --annotate v1' 'git tag --sign v1' 'git tag --delete v1' 'git tag --force v1'
ro '' 'git tag' "git tag -l 'v1.*'" "git tag -ln 'v1*'" 'git tag --list v1' 'git tag --sort=-v:refname' 'git tag --contains HEAD'
ro 1 'git notes add -m x' 'git notes edit' 'git notes remove' 'git notes copy a b' 'git notes append -m x' 'git notes merge x' 'git notes prune'
ro '' 'git notes list' 'git notes show'
ro 1 'git apply x.patch' 'git apply --index x.patch'
ro '' 'git apply --check x.patch' 'git apply --stat x.patch' 'git apply --numstat x.patch'
ro 1 'git branch -d x' 'git branch -D x' 'git branch -m a b' 'git branch -M a b' 'git branch -c a b' 'git branch -C a b' \
  'git branch -f x HEAD' 'git branch --delete x' 'git branch --move a b' 'git branch --copy a b' 'git branch --force x' 'git branch new'
ro '' 'git branch' 'git branch -a' 'git branch --show-current' 'git branch --contains HEAD' 'git branch --merged main' \
  "git branch --list 'amp-*'" 'git branch -al x'
ro 1 'git worktree add wt HEAD' "git worktree add '$hroot/src/wt' HEAD" 'git worktree add ./x' \
  "git worktree add '../hook repo/src/wt' HEAD" 'git worktree add src/$X'
ro '' 'git worktree add ../tmp-rev HEAD' 'git worktree add /tmp/rev' 'git worktree add .amp/04-x/wt HEAD' 'git worktree list' \
  "git worktree remove '$hroot/x'" 'git worktree remove --force wt'
# a target the shell expands can't be resolved here, so it passes
ro '' 'git worktree add "$TMPDIR/rev" HEAD' 'git worktree add "$(mktemp -d)"' 'git worktree add ~/rev' 'git worktree add $env:TEMP\rev' \
  'git worktree add %TEMP%\rev' 'git worktree add "`mktemp -d`"' 'git worktree add "/x/$(mktemp -u)"'
# the deny text names the role, what and the target, without the run suffix
hook "$(bash_json 'git status && git commit -m "x y"' amp-checker)"
[ "$out" = "$(reason "amp read-only: checker may not run git commit (git commit -m x y). $ro_tail")" ] || fail "deny text: $out"
denies "$(bash_json 'git worktree add wt' amp-scout)" 'amp read-only: scout may not run git worktree add (git worktree add wt)'
# the main loop and the other roles are only held to the guardrails
allows "$(bash_json 'git commit -m x')"
allows "$(bash_json 'git commit -m x' amp-implementer)"
ok

case=hook-patch
# apply_patch: every Add, Update, Delete and Move-to path is checked
add() { printf '*** Begin Patch\n*** Add File: %s\n+x\n*** End Patch' "$1"; }
hook "$(patch_json "$(add src/a.ts)" amp-reviewer)"
[ "$out" = "$(reason "amp read-only: reviewer may not edit files in the repository (src/a.ts). $ro_tail")" ] || fail "deny text: $out"
allows "$(patch_json "$(add .amp/04-x/r.md)" amp-reviewer)"
denies "$(patch_json $'*** Begin Patch\n*** Add File: .amp/04-x/r.md\n+x\n*** Update File: src/b.ts\n@@\n-a\n+b\n*** End Patch' amp-reviewer)" \
  'may not edit files in the repository (src/b.ts)'
denies "$(patch_json $'*** Begin Patch\n*** Update File: .amp/04-x/r.md\n*** Move to: src/c.ts\n@@\n-a\n+b\n*** End Patch' amp-checker)" '(src/c.ts)'
denies "$(patch_json $'*** Begin Patch\n*** Delete File: src/a.ts\n*** End Patch' amp-scout)" '(src/a.ts)'
# an absolute, backslashed path; on a drive-letter root, differently cased too (Review Focus 3)
win=$hroot
case $hroot in [a-zA-Z]:*) win=$(printf '%s' "$hroot" | tr '[:lower:]' '[:upper:]') ;; esac
win=$(printf '%s' "$win" | tr / '\\')
denies "$(patch_json "$(add "$win\\src\\a.ts")" amp-reviewer)" 'may not edit files in the repository'
allows "$(patch_json "$(add "$win\\.amp\\04-x\\r.md")" amp-reviewer)"
allows "$(patch_json "$(add /tmp/x.md)" amp-reviewer)"
allows "$(patch_json "$(add src/a.ts)")"
ok

case=hook-no-run
# without a ledger (or with a merged one) the guardrails are off; the read-only roles still deny
on feature/04-x
mv "$ledger" "$ledger.off"
allows "$(bash_json 'git reset --hard')"
denies "$(bash_json 'git commit -m x' amp-reviewer)" 'amp read-only: reviewer may not run git commit'
denies "$(patch_json "$(add src/a.ts)" amp-reviewer)" 'amp read-only: reviewer may not edit'
printf '# amp ledger — 04-x\nStage: build\nStage: merged — https://x/pull/1\n' > "$ledger"
allows "$(bash_json 'git reset --hard')"
mv "$ledger.off" "$ledger"
denies "$(bash_json 'git reset --hard')" 'amp guard: hard reset'
# outside a git repository every check is off
GIT_CEILING_DIRECTORIES=$tmp allows "$(printf '{"cwd":"%s","tool_name":"apply_patch","tool_input":{"command":"%s"},"agent_type":"amp-reviewer"}' \
  "$(js "$tmp/no repo")" "$(js "$(add a.ts)")")"
ok

case=hook-ledgers
# newer candidates that are no file (05-dir's progress.md is a directory: ls -td lists it by name
# and the [ -f ] check skips it), over 4 MiB or merged are skipped: the older run stays active
on feature/04-x
touch -t 202001010000 "$ledger"
mkdir -p "$hr/.amp/05-dir/progress.md" "$hr/.amp/06-big" "$hr/.amp/07-merged"
dd if=/dev/zero of="$hr/.amp/06-big/progress.md" bs=1024 count=4097 2>/dev/null
printf '# amp ledger — 07-merged\nStage: ship\nStage: merged — https://x/pull/2\n' > "$hr/.amp/07-merged/progress.md"
hook "$(bash_json 'git reset --hard')"
case $out in *'amp guard: hard reset'*"delete .amp/04-x/;"*) ;; *) fail "want the 04-x run's deny, got '$out'" ;; esac
mv "$ledger" "$ledger.off"
allows "$(bash_json 'git reset --hard')"
mv "$ledger.off" "$ledger"
rm -rf "$hr/.amp/05-dir" "$hr/.amp/06-big" "$hr/.amp/07-merged"
ok

case=hook-resume
# session-start (§5.6.2): the resumeText of the active run when it owns the current branch, else nothing
# start: pipe Codex's SessionStart input to amp-hook session-start from outside the repo; sets $out
start() {
  out=$(cd "$tmp" && bash "$ROOT/codex/hooks/amp-hook" session-start \
    <<< "{\"session_id\":\"s\",\"cwd\":\"$jroot\",\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}" 2>&1) \
    || fail "exit $?: $out"
}
# quiet: session-start prints nothing
quiet() { start; [ -z "$out" ] || fail "want no output, got '$out'"; }
# shows TEXT: session-start's output contains TEXT
shows() { start; case $out in *"$1"*) ;; *) fail "want '$1', got '$out'" ;; esac; }
# the hooks/run.test.ts fixture: every line form, CRLF, and the text resumeText makes of it
printf '%s\r\n' '# amp ledger — 04-x' 'Stage: grill' 'free text the parser ignores' 'Stage: build — tasks' \
  'Branch: feature/04-x' 'Plan: docs/amp/plans/p.md' 'Task 1: complete (commits a..b, review clean)' \
  'Task 2: minor (deferred): x' 'Task 2: complete (commits c..d, review clean | 2 parked)' '' \
  'Task 3a: fix round 2/5 (1 addressed, 1 open — y; commits e..f)' 'Ruling: r — w — c' \
  'Fallback: reviewer → sonnet (429)' 'Parallel: off — conflict' > "$ledger"
on feature/04-x
start
[ "$out" = "# amp run in progress (04-x)
Stage: build — tasks
Ledger: .amp/04-x/progress.md
Branch: feature/04-x
Plan: docs/amp/plans/p.md
Last task line: Task 3a: fix round 2/5 (1 addressed, 1 open — y; commits e..f)
An unfinished amp run owns this branch. When the user asks to continue, resume it with amp:phase 04-x: the ledger and git log are the ground truth. Don't start unrelated work on this branch without saying so." ] \
  || fail "resume text: $out"
on feature/other; quiet
on ''; quiet
# the 1.3.0 header still names the plan and branch
printf '# amp ledger — plan: docs/p.md — branch: feature/04-x\nStage: build\n' > "$ledger"
on feature/04-x
shows $'Stage: build\nLedger: .amp/04-x/progress.md\nBranch: feature/04-x\nPlan: docs/p.md\nAn unfinished'
# a run with no Branch yet owns only the default branch
printf '# amp ledger — 04-x\nStage: gate — grill summary ready\n' > "$ledger"
quiet
on main
shows $'# amp run in progress (04-x)\nStage: gate — grill summary ready\nLedger: .amp/04-x/progress.md\nAn unfinished'
printf '# amp ledger — 04-x\nStage: ship\nBranch: feature/04-x\nStage: merged — https://x/pull/1\n' > "$ledger"
on feature/04-x; quiet
# with two runs on the branch, the newer ledger wins
printf '# amp ledger — 04-x\nStage: build\nBranch: feature/04-x\n' > "$ledger"
mkdir -p "$hr/.amp/05-y"
printf '# amp ledger — 05-y\nStage: plan\nBranch: feature/04-x\n' > "$hr/.amp/05-y/progress.md"
touch -t 202001010000 "$ledger"; touch -t 202101010000 "$hr/.amp/05-y/progress.md"
shows '# amp run in progress (05-y)'
touch -t 202201010000 "$ledger"
shows '# amp run in progress (04-x)'
rm -rf "$hr/.amp/05-y"
# no .amp folder, or no repository: nothing
mv "$hr/.amp" "$hr/.amp.off"; quiet; mv "$hr/.amp.off" "$hr/.amp"
jroot=$(js "$tmp/no repo") GIT_CEILING_DIRECTORIES=$tmp quiet
jroot=$(js "$hroot")
ok
