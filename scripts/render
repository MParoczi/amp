#!/usr/bin/env bash
# Render the Claude Code and Codex trees from src/ (markup: docs/amp/specs/2026-10-31-02-codex-install.md §5.1).
#   src/skills/**     -> skills/**  and codex/skills/**
#   src/agents/<n>.md -> agents/<n>.md and codex/agents/amp-<n>.toml
# Renders into a temp dir and swaps the four trees in only on success.
# --check renders the same way and diffs against the working tree instead.
# AMP_RENDER_ROOT overrides the repo root (the test seam).
#
# Usage: render [--check]
set -euo pipefail

case "$*" in
  "") check=0 ;;
  --check) check=1 ;;
  *) echo "usage: render [--check]" >&2; exit 2 ;;
esac
root=${AMP_RENDER_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
for d in src/skills src/agents; do
  [ -d "$root/$d" ] || { echo "render: no $d in $root" >&2; exit 1; }
done
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
out=$tmp/out
trees=(skills agents codex/skills codex/agents)
for t in "${trees[@]}"; do mkdir -p "$out/$t"; done

# One pass per .md file and target. -v t=claude|codex, kind=skill|agent|other, src=<path for errors>,
# name=<agent name>. A codex agent is emitted as TOML.
prog='
BEGIN { toml = (t == "codex" && kind == "agent"); reduce = (t == "codex" && kind != "other") }
function die(msg) { printf "render: %s:%d: %s\n", src, NR, msg > "/dev/stderr"; failed = 1; exit 1 }
function header() {
  if (hdr++) return
  d = desc; gsub(/[\\"]/, "\\\\&", d)
  print "# Generated by scripts/render from " src ". Do not edit."
  print "name = \"amp-" name "\""
  print "description = \"" d "\""
  print "developer_instructions = '"'''"'"
}
$0 == "<!-- claude -->" || $0 == "<!-- codex -->" {
  if (blk != "") die("nested block opener")
  blk = substr($0, 6, length($0) - 9); blkline = NR; next
}
$0 == "<!-- /claude -->" || $0 == "<!-- /codex -->" {
  if (blk == "" || blk != substr($0, 7, length($0) - 10)) die("stray block closer")
  blk = ""; next
}
blk != "" && blk != t { next }
{
  s = ""; rest = $0
  while (match(rest, /\{\{(claude|codex):/)) {
    tool = substr(rest, RSTART + 2, RLENGTH - 3)
    s = s substr(rest, 1, RSTART - 1); rest = substr(rest, RSTART + RLENGTH)
    e = index(rest, "}}")
    if (!e) die("unterminated {{" tool ": span")
    text = substr(rest, 1, e - 1); sub(/^ /, "", text)
    if (tool == t) s = s text
    rest = substr(rest, e + 2)
  }
  s = s rest
  if (t == "codex") {
    gsub(/amp:implementer/, "amp-implementer", s); gsub(/amp:reviewer/, "amp-reviewer", s)
    gsub(/amp:checker/, "amp-checker", s); gsub(/amp:scout/, "amp-scout", s)
    gsub(/\$\{CLAUDE_PLUGIN_ROOT\}\/skills\//, "<skills>/", s)
    gsub(/\$\{CLAUDE_SKILL_DIR\}\//, "", s)
    gsub(/\/amp:/, "$amp:", s)
  }
  if (++emitted == 1 && s == "---") { infm = 1; if (!toml) print s; next }
  if (infm) {
    if (s == "---") { infm = 0; if (!toml) print s; next }
    if (reduce) {
      # lean: plain one-line name/description scalars, parse YAML if a source ever folds one
      if (s ~ /^[A-Za-z_-]+:/) { key = s; sub(/:.*/, "", key); keep = (key == "name" || key == "description") }
      if (toml) { if (key == "description" && s ~ /^description:/) { desc = s; sub(/^description:[ \t]*/, "", desc) }; next }
      if (!keep) next
    }
    print s; next
  }
  if (toml) { if (index(s, "'"'''"'")) die("agent body contains '"'''"'"); header() }
  print s
}
END {
  if (failed) exit 1
  if (blk != "") { NR = blkline; die("unclosed <!-- " blk " --> block") }
  if (toml) { header(); print "'"'''"'" }
}'

n=0
# md SRC_REL TARGET KIND DEST [NAME]
md() {
  LC_ALL=C awk -v t="$2" -v kind="$3" -v src="$1" -v name="${5-}" "$prog" "$root/$1" > "$4" || exit 1
  n=$((n + 1))
}

while IFS= read -r -d '' f; do
  rel=${f#"$root/src/skills/"}; dir=$(dirname "$rel"); base=$(basename "$rel")
  targets="claude codex"
  if [[ $base =~ ^(.+)\.(claude|codex)\.([^.]+)$ ]]; then
    targets=${BASH_REMATCH[2]}; base=${BASH_REMATCH[1]}.${BASH_REMATCH[3]}
  fi
  kind=other; [ "$base" = SKILL.md ] && kind=skill
  for t in $targets; do
    dest=$out/skills; [ "$t" = codex ] && dest=$out/codex/skills
    dest=$dest/$dir/$base
    mkdir -p "$(dirname "$dest")"
    if [[ $base == *.md ]]; then md "src/skills/$rel" "$t" "$kind" "$dest"
    else cp -p "$f" "$dest"; n=$((n + 1)); fi
  done
done < <(find "$root/src/skills" -type f -print0)

for f in "$root"/src/agents/*.md; do
  [ -f "$f" ] || continue
  a=$(basename "$f" .md)
  md "src/agents/$a.md" claude agent "$out/agents/$a.md"
  md "src/agents/$a.md" codex agent "$out/codex/agents/amp-$a.toml" "$a"
done

if [ "$check" -eq 0 ]; then
  for t in "${trees[@]}"; do
    rm -rf "${root:?}/$t"; mkdir -p "$(dirname "$root/$t")"; cp -a "$out/$t" "$root/$t"
  done
  echo "rendered: $n files"
  exit 0
fi

# Not diff -r: its output quotes paths with spaces, while comm and cmp give exact relative paths.
(cd "$out" && find "${trees[@]}" -type f) | sort > "$tmp/want"
(cd "$root" && find "${trees[@]}" -type f 2> /dev/null || true) | sort > "$tmp/have"
{
  comm -3 "$tmp/want" "$tmp/have" | cut -f 2-
  comm -12 "$tmp/want" "$tmp/have" | while IFS= read -r p; do
    cmp -s "$out/$p" "$root/$p" || printf '%s\n' "$p"
  done
} | sort > "$tmp/stale"
if [ -s "$tmp/stale" ]; then sed 's/^/render: stale: /' "$tmp/stale"; exit 1; fi
echo "render: up to date"
